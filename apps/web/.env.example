# Leave values blank for local dev. The app falls back to fixtures.

# Use the ACA managed identity client id for DefaultAzureCredential.
AZURE_CLIENT_ID=

# Point Cosmos clients at the account endpoint.
SRS_COSMOS_ENDPOINT=

# Select the Cosmos SQL database.
SRS_COSMOS_DATABASE_NAME=

# Select the Cosmos container that stores decision runs.
SRS_COSMOS_RUNS_CONTAINER_NAME=runs

# Select the Cosmos container that stores eval reports.
SRS_COSMOS_REPORTS_CONTAINER_NAME=reports

# Name the storage account for uploaded packet documents.
SRS_STORAGE_ACCOUNT=

# Match the ACA emitted storage account name.
SRS_STORAGE_ACCOUNT_NAME=

# Select the Blob container for uploaded packet documents.
SRS_STORAGE_UPLOADS_CONTAINER_NAME=uploads

# Point the Foundry client at the project or account endpoint.
SRS_FOUNDRY_ENDPOINT=

# Name the Foundry project when the endpoint is account-scoped.
SRS_FOUNDRY_PROJECT=

# Match the ACA emitted Foundry project name.
SRS_FOUNDRY_PROJECT_NAME=

# Name the hosted orchestrator agent. Defaults to orchestrator.
SRS_FOUNDRY_ORCHESTRATOR_AGENT_NAME=

# Override the hosted orchestrator invocation URL when needed.
SRS_FOUNDRY_ORCHESTRATOR_URL=

# Name the Azure OpenAI judge deployment used by reports.
SRS_JUDGE_DEPLOYMENT_NAME=

# Point judge tooling at a separate endpoint when it differs from Foundry.
SRS_JUDGE_ENDPOINT=

# Connect App Insights telemetry in ACA.
APPLICATIONINSIGHTS_CONNECTION_STRING=
